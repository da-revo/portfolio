---
import BaseLayout from '../layouts/BaseLayout.astro';

import ContactCTA from '../components/ContactCTA.astro';
import Hero from '../components/Hero.astro';
---

<BaseLayout title="About | Cyril Joy Mangalan" description="AI Product Engineer. Built cove.dev as CTO. Early engineer at marketfeed (YC S21). Founded ZIGG.">
	<div class="stack gap-20">
		<main class="wrapper about">
			<Hero
				title="About"
			>
				<img
					width="1553"
					height="873"
					src="/assets/cyril-tree.jpeg"
					alt="Cyril Joy Mangalan at work with a colleague"
				/>
			</Hero>

			<section>
				<h2 class="section-title">Background</h2>
				<div class="content">
					<p>
						As CTO at <a href="https://cove.dev">cove.dev</a>, I built the platform that took the company from $0 to hundreds of thousands in ARR and tens of millions in valuation. Before cove, I was an early engineer at <a href="https://marketfeed.com">marketfeed</a> (YC S21), where I helped grow the product to $16M+ AUM and drove the company's adoption of Go — which they now use for all their automated trading infrastructure.
					</p>
					<br>
					<p>
						I've been coding since middle school. Built the cove.dev platform end-to-end in Go and React. Drove gRPC and Protocol Buffer adoption at marketfeed. Founded ZIGG, where I built cross-platform mobile apps in Flutter, a Go backend, and managed a team of 6. I build across the full stack — backend, frontend, mobile, AI, and infrastructure.
					</p>
					<br>
					<p>
						Ran the Manipal half marathon. Competed in national-level athletics representing my high school. Diamond rank in Overwatch. I read philosophy and political theory, rave to techno, and lift.
					</p>
				</div>
			</section>
			<section>
				<h2 class="section-title">Education</h2>
				<div class="content">
					<p>
						<b>Bachelor of Technology in Computer Science & Engineering</b> <br>
						<b>Manipal Institute of Technology, Manipal University</b> <br>
						<i>Equivalent to Bachelor of Engineering (BEng) in Canada</i> <br>
						Graduated June 2021
						<br>
						<br>
						<b>Startup School</b> <br>
						<b>Y Combinator</b> <br>
						<i>
							<a href="https://www.startupschool.org/companies/getzigg">
								Participated in Startup School while building ZIGG.
							</a>
						</i> <br>
						Completed September 2021
						<br>
						<br>
						<b>Postgraduate Certificate in
							<a href="https://www.georgebrown.ca/programs/entrepreneurship-management-program-postgraduate-b416">
								Entrepreneurship Management
							</a>
						</b>
						<br>
						<b>George Brown Polytechnic</b> <br>
						<i>Dean's Honours List for Academic Excellence</i> <br>
						<i>
							<a href="https://learner.mycreds.ca/r/sharelink/bc7e9c03-fe31-4a3d-8d31-c1565aa06d95/e532cff4-6390-4954-a37a-488090ff76a7">
								Diploma
							</a>
						</i> <br>
						Graduated April 2024
						<br>
						<br>
						<b>
							<a href="https://continuingstudies.sauder.ubc.ca/courses/product-management-bootcamp">
								Product Management Bootcamp
							</a>
						</b>
						<p><b>Sauder School of Business, University of British Columbia</b></p> <br>
						<i>
							<a href="https://credentials.continuingstudies.sauder.ubc.ca/12b69023-dc40-4211-943a-1cd7b5ae1a9b">
								Certificate
							</a>
						</i>
						<p>Graduated June 2024</p>
					</p>
				</div>
			</section>
		</main>

		<ContactCTA />
	</div>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
	}

	img {
		margin-top: 1.5rem;
		border-radius: 1.5rem;
		box-shadow: var(--shadow-md);
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		color: var(--gray-200);
	}

	.section-title {
		grid-column-start: 1;
		font-size: var(--text-xl);
		color: var(--gray-0);
	}

	.content {
		grid-column: 2 / 4;
	}

	.content :global(a) {
		text-decoration: 1px solid underline transparent;
		text-underline-offset: 0.25em;
		transition: text-decoration-color var(--theme-transition);
	}

	.content :global(a:hover),
	.content :global(a:focus) {
		text-decoration-color: currentColor;
	}

	@media (min-width: 50em) {
		.about {
			display: grid;
			grid-template-columns: 1fr 60% 1fr;
		}

		.about > :global(:first-child) {
			grid-column-start: 2;
		}

		section {
			display: contents;
			font-size: var(--text-lg);
		}
	}
</style>
